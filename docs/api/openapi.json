{
  "openapi": "3.1.1",
  "info": {
    "title": "Compilarr",
    "version": "v1"
  },
  "paths": {
    "/api/v1/system/status": {
      "get": {
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemResource"
                }
              }
            }
          }
        }
      }
    },
    "/ping": {
      "get": {
        "tags": [
          "Ping"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {}
            }
          }
        }
      },
      "head": {
        "tags": [
          "Ping"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "parameters": [
          {
            "name": "refresh",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/login": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "parameters": [
          {
            "name": "loginFailed",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "returnUrl",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "Authentication"
        ],
        "parameters": [
          {
            "name": "returnUrl",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "Username": {
                    "type": "string"
                  },
                  "Password": {
                    "type": "string"
                  },
                  "RememberMe": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/logout": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/auth/user": {
      "get": {
        "tags": [
          "AuthUser"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/AuthUserResource"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthUserResource"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthUserResource"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "AuthUser"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAuthUserResource"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAuthUserResource"
              }
            },
            "application/*\u002Bjson": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAuthUserResource"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthUserResource": {
        "required": [
          "configured",
          "username"
        ],
        "type": "object",
        "properties": {
          "configured": {
            "type": "boolean"
          },
          "username": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "AuthenticationMethod": {
        "type": "integer"
      },
      "SystemResource": {
        "required": [
          "appName",
          "instanceName",
          "version",
          "buildTime",
          "isDebug",
          "isProduction",
          "isAdmin",
          "isUserInteractive",
          "startupPath",
          "appData",
          "osName",
          "osVersion",
          "isNetCore",
          "isLinux",
          "isOsx",
          "isWindows",
          "isDocker",
          "isContainerized",
          "mode",
          "branch",
          "authentication",
          "databaseType",
          "databaseVersion",
          "migrationVersion",
          "urlBase",
          "runtimeVersion",
          "runtimeName",
          "startTime",
          "packageVersion",
          "packageAuthor",
          "packageUpdateMechanism"
        ],
        "type": "object",
        "properties": {
          "appName": {
            "type": "string"
          },
          "instanceName": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "buildTime": {
            "type": "string",
            "format": "date-time"
          },
          "isDebug": {
            "type": "boolean"
          },
          "isProduction": {
            "type": "boolean"
          },
          "isAdmin": {
            "type": "boolean"
          },
          "isUserInteractive": {
            "type": "boolean"
          },
          "startupPath": {
            "type": "string"
          },
          "appData": {
            "type": "string"
          },
          "osName": {
            "type": "string"
          },
          "osVersion": {
            "type": "string"
          },
          "isNetCore": {
            "type": "boolean"
          },
          "isLinux": {
            "type": "boolean"
          },
          "isOsx": {
            "type": "boolean"
          },
          "isWindows": {
            "type": "boolean"
          },
          "isDocker": {
            "type": "boolean"
          },
          "isContainerized": {
            "type": "boolean"
          },
          "mode": {
            "type": "string"
          },
          "branch": {
            "type": "string"
          },
          "authentication": {
            "$ref": "#/components/schemas/AuthenticationMethod"
          },
          "databaseType": {
            "type": "string"
          },
          "databaseVersion": {
            "type": "string"
          },
          "migrationVersion": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "urlBase": {
            "type": "string"
          },
          "runtimeVersion": {
            "type": "string"
          },
          "runtimeName": {
            "type": "string"
          },
          "startTime": {
            "type": "string",
            "format": "date-time"
          },
          "packageVersion": {
            "type": "string"
          },
          "packageAuthor": {
            "type": "string"
          },
          "packageUpdateMechanism": {
            "type": "string"
          }
        }
      },
      "UpdateAuthUserResource": {
        "required": [
          "username",
          "password"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": [
              "null",
              "string"
            ]
          },
          "password": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "System"
    },
    {
      "name": "Ping"
    },
    {
      "name": "Health"
    },
    {
      "name": "Authentication"
    },
    {
      "name": "AuthUser"
    }
  ]
}
