# Copy to .env and fill in. Never commit .env.

# --- AI build workflow (docs/build/AGENT_WORKFLOW.md) ---
# OpenRouter key used by worker runs (scripts/worker.py). The orchestrator is the Claude Code session itself (Claude Opus 5.5) and uses your normal Claude login, not this key.
OPENROUTER_API_KEY=
# Worker model id in OpenRouter "provider/model" form. Pick after the bake-off in AGENT_WORKFLOW.md §6.
WONDARR_WORKER_MODEL=
# Optional mid-tier reviewer model for independent code review of worker output.
WONDARR_REVIEWER_MODEL=
# Hard caps per worker run.
WONDARR_WORKER_MAX_TURNS=25
WONDARR_WORKER_TIMEOUT_MIN=20

# --- Runtime secrets used during development/testing of the app itself ---
ACOUSTID_CLIENT_KEY=          # register at https://acoustid.org/new-application
PLEX_TOKEN=                   # optional, for Plex integration tests
SOULSEEK_USERNAME=            # dedicated account for the bundled slskd
SOULSEEK_PASSWORD=
