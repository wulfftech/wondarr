#!/command/with-contenv sh
#
# Applies PUID/PGID to the bundled wondarr account and prepares the /config layout, the way
# hotio/LinuxServer images do. Runs as an s6-rc oneshot, before svc-wondarr starts.
#
# /data is deliberately left alone: it is the user's own tree (and is usually a bind mount), so
# ownership there is the user's business — only /config and its subdirectories are ours.
set -eu

: "${PUID:=1000}"
: "${PGID:=1000}"

case "$PUID" in
    '' | *[!0-9]*)
        echo "init-wondarr-user: PUID must be an integer, got '$PUID'" >&2
        exit 1
        ;;
esac

case "$PGID" in
    '' | *[!0-9]*)
        echo "init-wondarr-user: PGID must be an integer, got '$PGID'" >&2
        exit 1
        ;;
esac

groupmod -o -g "$PGID" wondarr
usermod -o -u "$PUID" wondarr

mkdir -p /config /config/logs /config/slskd
# Re-own only what does not already match, so a changed PUID/PGID also covers wondarr.db and
# config.yml from an earlier run, without rewriting every file on each start.
find /config -xdev \( ! -user wondarr -o ! -group wondarr \) -exec chown wondarr:wondarr {} +

echo "init-wondarr-user: wondarr now runs as uid $(id -u wondarr), gid $(id -g wondarr)"
