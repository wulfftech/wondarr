<?xml version="1.0" encoding="UTF-8"?>
<!-- An older Newznab install that spells music search <audio-search> instead of <music-search>. -->
<caps>
  <server version="0.1" title="Example Newznab"/>
  <limits max="100" default="100"/>
  <searching>
    <search available="yes" supportedParams="q"/>
    <audio-search available="yes" supportedParams="q,artist,album"/>
  </searching>
  <categories>
    <category id="3000" name="Music" description="Music"/>
  </categories>
</caps>
