<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Wondarr.Core.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\tests\fixtures\logging\**\*.json" Link="fixtures\logging\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tests\fixtures\version-flags.json" Link="fixtures\version-flags.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tests\fixtures\album-policy.json" Link="fixtures\album-policy.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tests\fixtures\importlists\*.csv" Link="fixtures\importlists\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tests\fixtures\decisions.json" Link="fixtures\decisions.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tests\fixtures\plex\**\*.json" Link="fixtures\plex\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tests\fixtures\lrclib\**\*.json" Link="fixtures\lrclib\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tests\fixtures\listenbrainz\**\*.json" Link="fixtures\listenbrainz\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tests\fixtures\listenbrainz\*.html" Link="fixtures\listenbrainz\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Wondarr.Core\Wondarr.Core.csproj" />
  </ItemGroup>

</Project>
